# ==============================================================================
# KnowledgeOS: Environment Configuration Template
# Copy this file to .env and configure your credentials.
# ==============================================================================

# Primary LLM Engine (Groq Cloud API - recommended for sub-200ms agent execution)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Security & API Authentication
KNOWLEDGEOS_API_KEY=dev-key
KNOWLEDGEOS_ENV=development

# Platform Performance & Rate Limiting
RATE_LIMIT_PER_MINUTE=120
RETRIEVAL_TOP_K=8
MAX_AGENT_RETRIES=2
MEMORY_DECAY_HALFLIFE_HOURS=72

# Storage & Infrastructure (Defaults to embedded durable SQLite)
KNOWLEDGEOS_STATE_PATH=.knowledgeos/knowledgeos.sqlite3
ENABLE_METRICS=true

# Optional Enterprise Integrations
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4o
# VOYAGE_API_KEY=your-voyage-api-key
# VOYAGE_MODEL=voyage-3-large
# REDIS_DSN=redis://localhost:6379/0
# POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/knowledgeos
# MILVUS_URI=http://localhost:19530
